# Copy this file to .env and fill in your keys
# Never commit .env to version control

# FRED API key — free at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Nasdaq Data Link (formerly Quandl) — free tier at https://data.nasdaq.com
# Only needed if you add Baltic Dry Index ingestion later
NASDAQ_DATA_LINK_API_KEY=your_nasdaq_key_here
